# Copy to .env for local live runs (`cp .env.example .env`). .env is git-ignored.
# For the nightly job, set the same names as GitHub Actions secrets instead.
# Nothing here is needed for offline runs: `python -m pipeline nightly --offline --dry-run`.

# Google Cloud key restricted to "Places API (New)" only. SETUP_CHECKLIST.md §2.
GOOGLE_PLACES_API_KEY=
# Google Cloud key restricted to "PageSpeed Insights API" only. SETUP_CHECKLIST.md §2.
PSI_API_KEY=
# Google AI Studio → Get API key. SETUP_CHECKLIST.md §3.
GEMINI_API_KEY=
# Current Flash model name shown in AI Studio (default gemini-2.5-flash if empty). SETUP_CHECKLIST.md §3.
GEMINI_MODEL=

# Supabase → Project Settings → API → Project URL. SETUP_CHECKLIST.md §4.
SUPABASE_URL=
# Supabase → Project Settings → API → service_role key. PIPELINE ONLY: never in the dashboard. SETUP_CHECKLIST.md §4.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → API → anon public key. Dashboard build only. SETUP_CHECKLIST.md §4.
SUPABASE_ANON_KEY=

# Nova Host cPanel → FTP Accounts (user scoped to the leads subdomain folder). SETUP_CHECKLIST.md §5.
# Only used by the deploy-dashboard GitHub workflow; not needed locally.
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
# Usually "/" for a folder-scoped FTP user. SETUP_CHECKLIST.md §5.
FTP_DIR=

# Dashboard (dashboard/.env.local). Same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
# Leave VITE_SUPABASE_URL empty to run the dashboard on mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
